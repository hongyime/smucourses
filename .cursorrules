{
  "project_context": "smucourses - A premium, static-site course discovery tool for SMU students.",
  "tech_stack": {
    "framework": "Next.js 15 (App Router)",
    "styling": "Tailwind CSS (v4)",
    "animations": "Framer Motion",
    "icons": "Lucide React",
    "data_source": "src/data/courses.json"
  },
  "rules": [
    "Use Tailwind CSS for all styling.",
    "Prioritize Static Site Generation (SSG) over client-side fetching.",
    "When building UI, adhere to the 'Dark Academic' theme: deep dark backgrounds (#0a0a0a), glassmorphism (backdrop-blur-md, bg-white/5, border-white/10), and subtle animations.",
    "All data must be derived from the local JSON files; do not suggest external databases (No Supabase, No MongoDB).",
    "Ensure all components are type-safe with TypeScript.",
    "Maintain a high-performance mindset: search and filtering must be instantaneous (<200ms) using useMemo and Fuse.js."
  ],
  "directory_structure": {
    "data": "src/data/courses.json (Single Source of Truth)",
    "components": "src/components/ (Modular UI components)",
    "styles": "src/app/globals.css (Tailwind entry point)"
  }
}
